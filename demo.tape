Output demo.gif

Set Shell zsh
Set FontFamily "SauceCodePro Nerd Font Mono"
Set FontSize 16
Set Width 1200
Set Height 600
Set Theme GruvboxDark
Set Padding 12
Set Framerate 25
Set TypingSpeed 70ms

Hide
Type "export PATH=$PWD/target/release:$PWD/target/release/examples:$PATH; clear"
Enter
Show

Type "demo"
Sleep 400ms
Enter
Sleep 3s

Type "J"
Sleep 2s
Type "N"
Sleep 2.5s

Type "f"
Type "back"
Sleep 800ms
Enter
Sleep 2.5s

Type "a"
Sleep 2.5s
Type "x"
Sleep 1.5s
Type "5"
Sleep 2s

Type "i"
Type "Reviewed it, looks good to me. Deploying after lunch :rocket:"
Sleep 700ms
Enter
Sleep 5s
Escape
Sleep 500ms

Type "m"
Sleep 2s
Type "m"
Sleep 500ms

Type ":status away"
Sleep 500ms
Enter
Sleep 2s

Type ":dm ma"
Sleep 1s
Enter
Sleep 2s
Type "i"
Type "Sure, give me ten minutes."
Sleep 500ms
Enter
Sleep 1.5s
Escape
Sleep 500ms

Type ":server club"
Sleep 500ms
Enter
Sleep 2.5s
Type "J"
Sleep 2.5s

Type "?"
Sleep 3s
Escape
Sleep 500ms
Type ":q"
Enter
Sleep 1s
